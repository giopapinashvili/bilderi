rules_version = '2';
// ბილდერის უსაფრთხოების წესები: თითოეული მომხმარებელი მხოლოდ საკუთარ საიტებს ხედავს და ცვლის.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)).data.owner == request.auth.uid;
    }

    match /sites/{siteId} {
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data.size() < 900000;

      match /images/{imgId} {
        allow read, delete: if signedIn() && owns(siteId);
        allow create, update: if signedIn() && owns(siteId)
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.data.size() < 1000000;
      }
    }

    // გამოქვეყნებული საიტები: ყველას შეუძლია ნახვა, ცვლა მხოლოდ მფლობელს.
    // დოკუმენტის ID საიტის მისამართია (slug), ამიტომ ერთ მისამართს მხოლოდ ერთი მფლობელი ჰყავს.
    function pubOwner(slug) {
      return get(/databases/$(database)/documents/published/$(slug)).data.owner == request.auth.uid;
    }
    match /published/{slug} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && slug.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$')
        && !(slug in ['admin', 'api', 'app', 'www', 'mail', 'bog', 'tbc', 'bank', 'gov', 'police', 'support', 'help', 'login', 'bilderi', 'pay', 'editor', 'templates'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data.size() < 900000;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /images/{imgId} {
        allow get: if true;
        allow list, delete: if signedIn() && pubOwner(slug);
        allow create, update: if signedIn() && pubOwner(slug)
          && request.resource.data.data.size() < 1000000;
      }
    }
  }
}
