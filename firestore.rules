rules_version = '2';
// ბილდერის უსაფრთხოების წესები: თითოეული მომხმარებელი მხოლოდ საკუთარ საიტებს ხედავს და ცვლის.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)).data.owner == request.auth.uid;
    }

    match /sites/{siteId} {
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data.size() < 900000;

      match /images/{imgId} {
        allow read, delete: if signedIn() && owns(siteId);
        allow create, update: if signedIn() && owns(siteId)
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.data.size() < 1000000;
      }
    }
  }
}
