{
  // Cloudflare Worker: public/ საქაღალდის ფაილები + გამოქვეყნებული საიტები /s/{slug}/ მისამართზე
  "name": "bilderi",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/s/*"]
  },
  "observability": { "enabled": true }
}
